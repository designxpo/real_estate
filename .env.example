# Postgres connection string (Supabase, Neon, Railway, or local Docker).
# Supabase: use the Supavisor POOLER host (the direct db.<ref> host is IPv6-only).
#   Runtime (DATABASE_URL): transaction pooler, port 6543, ?pgbouncer=true
#   Migrations (DIRECT_URL): session pooler, port 5432
# Percent-encode special chars in the password (e.g. # -> %23).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Secret for cron/admin endpoints (release-expired, geocode-listings). REQUIRED:
# those endpoints fail closed (503) if this is unset. Send as: Authorization: Bearer <secret>
CRON_SECRET=""

# Public site origin (no trailing slash) — used by sitemap/robots/canonical URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Firebase Cloud Messaging (owner push notifications) --------------------
# Local dev: just place firebase-service-account.json in the repo root (gitignored).
# Serverless (Vercel): set the service-account JSON as base64 (no file needed):
#   base64 -i firebase-service-account.json | tr -d '\n'   →  paste as the value
FIREBASE_SERVICE_ACCOUNT_B64=""

# 32+ char random string for signing session JWTs (broker cookies + owner tokens)
SESSION_SECRET=""

# Cookie domain in prod; leave blank for localhost
SESSION_COOKIE_DOMAIN=""

# --- Platform owner console (/platform) -------------------------------------
# Bootstrap super-admin. On first login at /platform/login these seed an admin
# (idempotent — only created once). Change the password after first login.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""
PLATFORM_ADMIN_NAME="Platform Owner"

# When true (default in dev), OTPs are logged to console instead of sent via SMS
DEV_OTP_LOG=true

# TESTING ONLY: accept a fixed OTP (OTP_TEST_CODE, default 123456) so testers can
# sign in without a live SMS provider — works even on a production deploy.
# ⚠️ MUST be false/unset for real launch once MSG91 is configured.
OTP_TEST_MODE="false"
OTP_TEST_CODE="123456"

# MSG91 (Phase 1 follow-up). Leave blank in dev.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# --- Cloudflare R2 photo storage (owner app, Phase 0) -----------------------
# From Cloudflare dashboard → R2. R2 is S3-compatible; no AWS account needed.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="realty-listings"
# Public read URL base (R2 public r2.dev URL or your custom domain), no trailing slash
R2_PUBLIC_BASE_URL=""
